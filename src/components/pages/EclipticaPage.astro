---
// Ecliptica hub body (issue #72): skeleton route. The full hub content ships
// in the dedicated Ecliptica issue; this page is crawlable from day one with
// the verified Steam links, a pointer to the project page and the roadmap
// teaser from the roadmap content collection. Rendered by
// src/pages/ecliptica/index.astro (EN) and src/pages/[locale]/ecliptica.astro
// (RU/DE/ES).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, localeHref, DEFAULT_LOCALE } from '../../i18n';

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const roadmap = (await getCollection('roadmap')).find((entry) => entry.data.project === 'ecliptica');
const rendered = roadmap ? await render(roadmap) : null;
---
<Base title={`Ecliptica — ${t(locale, 'meta.title')}`} description={t(locale, 'pages.eclipticaTagline')}>
	<section class="section">
		<div class="container max-w-4xl">
			<div class="ecliptica-featured text-center">
				<img
					src="/assets/images/ecliptica_icon_logo.png.webp"
					srcset="/assets/images/ecliptica_icon_logo-240.webp 240w, /assets/images/ecliptica_icon_logo.png.webp 256w"
					sizes="120px"
					alt="Ecliptica Logo"
					class="ecliptica-logo mx-auto"
					width="120"
					height="120"
				>
				<h1 class="ecliptica-title mt-4">Ecliptica</h1>
				<p class="ecliptica-subtitle mt-2">{t(locale, 'hero.eclipticaSubtitle')}</p>
				<p class="mt-3 text-muted">{t(locale, 'pages.eclipticaTagline')}</p>
				<div class="mt-6 flex flex-wrap justify-center gap-3">
					<a href="https://store.steampowered.com/app/3723390/Ecliptica/" target="_blank" rel="noopener" class="btn btn-steam-primary">
						<svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-steam" /></svg>
						{t(locale, 'projectsDetail.btnSteam')}
					</a>
					<a href="https://store.steampowered.com/wishlist/add/item?appid=3723390" target="_blank" rel="noopener" class="btn btn-wishlist">
						<svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-heart" /></svg>
						{t(locale, 'projectsDetail.btnWishlist')}
					</a>
					<a href={localeHref(locale, '/projects/ecliptica')} class="btn btn-secondary">
						<svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-box" /></svg>
						{t(locale, 'featured.details')}
					</a>
				</div>
			</div>
		</div>
	</section>

	{roadmap && rendered && (
		<section class="section section-alt pt-10">
			<div class="container max-w-4xl">
				<h2 class="section-title">{roadmap.data.title}</h2>
				<div class="prose-invert mt-4 text-muted">
					<rendered.Content />
				</div>
			</div>
		</section>
	)}
</Base>