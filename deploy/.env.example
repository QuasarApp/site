# QuasarApp site - deployment environment (issue #83).
# Copy this file to deploy/.env on the VPS and adjust the values.
# deploy/.env is git-ignored - never commit real values.

# Domain served by Caddy. Let's Encrypt issues and renews the certificate
# for it automatically (HTTP/3 enabled). Use localhost for local Docker runs.
SITE_ADDRESS=quasarapp.me

# Let's Encrypt (ACME) account email.
ACME_EMAIL=quasarappdevelop@gmail.com

# Contact form endpoint (api/server.js) per-IP rate limit.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
