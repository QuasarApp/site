---
// EN project detail routes (issue #72): generated from the projects content
// collection (src/content/projects/{slug}.md); the page body is shared with
// the /[locale]/ detail routes.
import { getCollection } from 'astro:content';
import ProjectDetailPage from '../../components/pages/ProjectDetailPage.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { slug: project.id },
	}));
}

const { slug } = Astro.props;
---
<ProjectDetailPage slug={slug} />
