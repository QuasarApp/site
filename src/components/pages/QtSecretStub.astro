---
// Noindex redirect stub (successor of the legacy /projects/qt-secret stub):
// Qt-Secret's canonical slug is /projects/qtssecret. Rendered by
// src/pages/projects/qt-secret/index.astro (EN) and
// src/pages/[locale]/projects/qt-secret/index.astro (RU/DE/ES).
import { localeHref, DEFAULT_LOCALE } from '../../i18n';

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
---
<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8">
		<meta name="robots" content="noindex">
		<meta http-equiv="refresh" content={`0; url=${localeHref(locale, '/projects/qtssecret')}`}>
		<link rel="canonical" href={localeHref(locale, '/projects/qtssecret')}>
		<title>Qt-Secret — QuasarApp Group</title>
	</head>
	<body>
		<p>
			<a href={localeHref(locale, '/projects/qtssecret')}>Qt-Secret</a>
		</p>
	</body>
</html>